# Copy to .env and fill in real values. NEVER commit .env.

# --- LLM provider (swappable interface) ---
# One of: openai | anthropic | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-4o-mini

# --- App ---
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/jobflow.db

# --- Pipeline / automation ---
# DRY_RUN=true (default): fill forms + screenshot, NEVER submit.
DRY_RUN=true
# Auto-submit only enabled when DRY_RUN=false AND match score >= this.
MIN_MATCH_SCORE=70

# --- Polite scraping ---
REQUEST_DELAY_SECONDS=2
USER_AGENT=Mozilla/5.0 (jobflow-local-automation)
